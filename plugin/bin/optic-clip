#!/bin/bash
# Save the image on the clipboard as PNG under $OPTIC_CAPTURES (default ~/.optic/captures) and print its path.
set -euo pipefail
dir=${OPTIC_CAPTURES:-$HOME/.optic/captures}
mkdir -p "$dir"
out=$dir/clip-$(date +%Y%m%d-%H%M%S).png
if ! osascript - "$out" >/dev/null 2>&1 <<'EOF'
on run argv
  set png to the clipboard as «class PNGf»
  set f to open for access (POSIX file (item 1 of argv)) with write permission
  set eof f to 0
  write png to f
  close access f
end run
EOF
then
  rm -f "$out"
  echo "optic-clip: the clipboard holds no image" >&2
  exit 1
fi
echo "$out"
